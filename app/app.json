{
  "expo": {
    "name": "Powerhub 24/7",
    "slug": "powerhub",
    "scheme": "powerhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/padded-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frodo06.powerhub",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Wymagane do otwierania zamka."
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/padded-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.frodo06.powerhub",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "893b804a-c41f-4ece-a21a-586220b5ec40"
      }
    },
    "owner": "frodo06"
  }
}
